{
  "manifest_version": 3,
  "name": "YTMP3 Quick Convert",
  "version": "1.0.0",
  "description": "Adds a Convert MP3 button below YouTube videos that opens the YTMP3 web converter with the current URL.",
  "action": {
    "default_title": "YTMP3 Quick Convert"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://m.youtube.com/watch*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "host_permissions": [
    "https://mis-ytmp3-backend.onrender.com/*"
  ]
}
