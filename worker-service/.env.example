PORT=8080
WORKER_SHARED_SECRET=super-secret-string-same-as-main-app
SELF_URL=https://ytmp3-worker-xyz.up.railway.app
WORKER_COOKIES_PATH=/tmp/cookies.txt
WORKER_COOKIES_SYNC_URL=https://main-app.example.com/internal/worker/cookies
# Optional override (defaults to WORKER_SHARED_SECRET when empty)
WORKER_COOKIES_SYNC_TOKEN=
# Optional interval (ms) to refresh cookies when running long-lived workers
WORKER_COOKIES_REFRESH_INTERVAL_MS=300000
