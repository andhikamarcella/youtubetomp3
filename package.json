{
  "name": "ytmp3-backend",
  "type": "module",
  "scripts": {
    "prestart": "node scripts/prepare_mobile_header.mjs",
    "start": "node index.js",
    "dev": "node scripts/prepare_mobile_header.mjs && node --watch index.js",
    "build": "node --check scripts/prepare_mobile_header.mjs && node --check public-ui/mobile-header-emergency.js && node --check public-ui/forum-interaction-emergency.js && node --check public-ui/forum-auth-stability.js && node --check public-ui/modal-accessibility-polish.js && node --check public-ui/modal-lifecycle-guard.js && node --check public-ui/tailwind-ui-bridge.js && node --check index.js",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/*.test.js",
    "test:security": "node --test tests/security-regression.test.js tests/socket-security.test.js tests/upload-security-regression.test.js",
    "test:e2e": "node --test tests/e2e-smoke.test.js",
    "test:accessibility": "node --test tests/accessibility-static.test.js",
    "secret-scan": "node scripts/secret_scan.mjs",
    "audit": "npm audit --audit-level=high --omit=dev",
    "migrate:xp": "node scripts/migrate_xp_events.js",
    "sync:stickers": "node scripts/sync_stickers_firestore.mjs"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cors": "^1.8.5",
    "express": "^4.22.1",
    "firebase-admin": "^13.5.0",
    "nanoid": "^5.1.5",
    "nodemailer": "^9.0.3",
    "socket.io": "^4.8.1"
  },
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andhikamarcella/youtubetomp3.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andhikamarcella/youtubetomp3/issues"
  },
  "homepage": "https://github.com/andhikamarcella/youtubetomp3#readme"
}
