{
  "name": "ytconv",
  "version": "1.7.1",
  "description": "Secure cross-platform social-media downloader CLI with an interactive help center, stable documentation links, guided diagnostics, browser-login recovery, animated progress, native packages, and verified release provenance.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ytconv": "bin/ytconv-auth.js"
  },
  "files": [
    "bin/*.js",
    "src/*.js",
    "types/*.d.ts",
    "scripts/*.js",
    "scripts/*.sh",
    "scripts/*.cmd",
    "scripts/*.ps1",
    "ish/VERSION",
    "ish/*.py",
    "ish/SHA256SUMS",
    "docs/*.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/ytconv-auth.js",
    "check": "node ./scripts/check-syntax.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:ish": "python3 -m py_compile ./ish/ytconv.py ./ish/ytconv-core.py ./scripts/test-ish.py && sh -n ./scripts/install-ish.sh && sh -n ./scripts/install-termux.sh && sh -n ./scripts/install-unix.sh",
    "test": "node ./scripts/test-cli.js",
    "test:browser": "node ./scripts/test-managed-browser.js",
    "test:ish": "python3 ./ish/ytconv.py --version && python3 ./scripts/test-ish.py",
    "security": "npm audit --omit=dev && node --test ./test/security.test.js ./test/supply-chain.test.js ./test/identity-ui.test.js",
    "prepack": "npm run docs:check && npm run check && npm run typecheck && npm test && npm run test:help-center && npm run check:ish && npm run security",
    "docs:check": "node ./scripts/check-docs.js",
    "test:help-center": "node --test ./test/help-center.test.js"
  },
  "keywords": [
    "ytconv",
    "yt-dlp",
    "gallery-dl",
    "ffmpeg",
    "youtube",
    "youtube-downloader",
    "youtube-downloader-cli",
    "youtube-mp4",
    "youtube-mp3",
    "mp4-downloader",
    "mp3-converter",
    "youtube-music",
    "instagram",
