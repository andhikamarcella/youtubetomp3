  "releaseDate": "2026-08-06",
  "releaseNotes": "YTConv 1.7.1 preserves the recognizable Figlet terminal identity and Commander command UX, fixes stable HEAD documentation links, adds an interactive terminal help center with docs, about, and shortcuts commands, improves discoverability and responsive help output, keeps subtitles off by default, and refreshes every supported package identity while preserving the established secure download core.",
  "releaseNotesUrl": "https://github.com/andhikamarcella/YTConv/blob/release/ytconv-1.7.1/cli/CHANGELOG.md",
  "installer": {
    "type": "Multi-format release",
    "npm": "https://registry.npmjs.org/ytconv/-/ytconv-1.7.1.tgz",
    "release": "https://github.com/andhikamarcella/YTConv/releases/tag/ytconv-v1.7.1",
    "sha256Url": "https://github.com/andhikamarcella/YTConv/releases/download/ytconv-v1.7.1/SHA256SUMS.txt",
    "sbomUrl": "https://github.com/andhikamarcella/YTConv/releases/download/ytconv-v1.7.1/ytconv-1.7.1.cdx.json"
  },
  "securityCapabilities": {
    "network": "Only user-requested media/provider URLs, npm metadata checks, and allowlisted HTTPS engine release endpoints.",
    "childProcesses": "Executable plus argument arrays only; shell execution is disabled.",
    "filesystem": "User-selected output, YTConv configuration/cache, verified engine storage, and short-lived private cookie exports.",
    "environment": "Allowlisted configuration reads; secrets are stripped before child processes.",
    "telemetry": false
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.18.0",
  "preferGlobal": true,
  "sideEffects": false,
  "dependencies": {
