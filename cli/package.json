    "supply-chain-security",
    "socket-security",
    "provenance",
    "sbom",
    "typescript",
    "typed-api",
    "termux",
    "ish",
    "ssh",
    "powershell",
    "cmd",
    "windows",
    "linux",
    "ubuntu",
    "debian",
