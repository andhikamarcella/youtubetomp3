  "licenseUrl": "https://github.com/andhikamarcella/youtubetomp3/blob/release/ytconv-1.6.6-zero-deps-final/cli/LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andhikamarcella/youtubetomp3.git",
