{
  "name": "ytconv",
  "version": "0.5.2",
  "description": "Powerful one-link social media converter TUI for desktop and Termux.",
  "type": "module",
  "bin": "bin/ytconv.js",
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node ./scripts/postinstall.js",
    "start": "node ./bin/ytconv.js",
    "check": "node --check ./bin/ytconv.js && node --check ./src/ui.js && node --check ./src/terminal-input.js && node --check ./src/cookies.js && node --check ./src/platform.js && node --check ./src/binaries.js && node --check ./src/dependencies.js && node --check ./src/downloader.js && node --check ./scripts/postinstall.js",
    "test": "node --test ./test/*.test.js"
  },
  "keywords": [
    "yt-dlp",
    "ffmpeg",
    "youtube",
    "instagram",
    "tiktok",
    "pinterest",
    "twitter",
    "facebook",
    "social-media",
    "downloader",
    "converter",
    "cookies",
    "termux",
    "android",
    "tui",
    "cli",
    "terminal"
  ],
  "author": "Andhika Marcella Fernanda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andhikamarcella/youtubetomp3.git",
    "directory": "cli"
  },
  "homepage": "https://ytconv.onrender.com/",
  "bugs": {
    "url": "https://github.com/andhikamarcella/youtubetomp3/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "figlet": "^1.8.2",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "which": "^5.0.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
