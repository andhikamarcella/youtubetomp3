  "releaseDate": "2026-08-05",
  "releaseNotes": "YTConv 1.6.6 removes every production npm dependency, replaces React, Ink, Figlet, ws, and which with audited Node.js built-ins, preserves Windows EXE, Android packaging, DEB, RPM, Arch, Alpine APK, AppImage, Snap, Flatpak, Nix, Termux, iSH and Alpine update paths, and adds Socket-focused package-content gates.",
  "releaseNotesUrl": "https://github.com/andhikamarcella/youtubetomp3/blob/release/ytconv-1.6.6-zero-deps-final/cli/CHANGELOG.md",
  "installer": {
    "type": "Multi-format release",
    "npm": "https://registry.npmjs.org/ytconv/-/ytconv-1.6.6.tgz",
    "release": "https://github.com/andhikamarcella/youtubetomp3/releases/tag/ytconv-v1.6.6",
    "sha256Url": "https://github.com/andhikamarcella/youtubetomp3/releases/download/ytconv-v1.6.6/SHA256SUMS.txt",
    "sbomUrl": "https://github.com/andhikamarcella/youtubetomp3/releases/download/ytconv-v1.6.6/ytconv-1.6.6.cdx.json"
  },
  "securityCapabilities": {
    "network": "Only user-requested media/provider URLs, npm metadata checks, and allowlisted HTTPS engine release endpoints.",
    "childProcesses": "Executable plus argument arrays only; shell execution is disabled.",
    "filesystem": "User-selected output, YTConv configuration/cache, verified engine storage, and short-lived private cookie exports.",
    "environment": "Allowlisted configuration reads; secrets are stripped before child processes.",
    "telemetry": false
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.18.0",
  "preferGlobal": true,
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
