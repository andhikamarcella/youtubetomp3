{
  "name": "ytconv",
  "version": "1.7.0",
  "description": "Secure cross-platform social-media downloader CLI with guided diagnostics, browser-login recovery, animated progress, native packages, expanded documentation, and verified release provenance.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ytconv": "bin/ytconv-auth.js"
  },
  "files": [
    "bin/*.js",
    "src/*.js",
    "types/*.d.ts",
    "scripts/*.js",
    "scripts/*.sh",
    "scripts/*.cmd",
    "scripts/*.ps1",
    "ish/VERSION",
    "ish/*.py",
    "ish/SHA256SUMS",
    "docs/*.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/ytconv-auth.js",
    "check": "node ./scripts/check-syntax.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:ish": "python3 -m py_compile ./ish/ytconv.py ./ish/ytconv-core.py ./scripts/test-ish.py && sh -n ./scripts/install-ish.sh && sh -n ./scripts/install-termux.sh && sh -n ./scripts/install-unix.sh",
    "test": "node ./scripts/test-cli.js",
    "test:browser": "node ./scripts/test-managed-browser.js",
    "test:ish": "python3 ./ish/ytconv.py --version && python3 ./scripts/test-ish.py",
    "security": "npm audit --omit=dev && node --test ./test/security.test.js ./test/supply-chain.test.js ./test/identity-ui.test.js",
    "prepack": "npm run docs:check && npm run check && npm run typecheck && npm test && npm run check:ish && npm run security",
    "docs:check": "node ./scripts/check-docs.js"
  },
  "keywords": [
    "ytconv",
    "yt-dlp",
    "gallery-dl",
    "ffmpeg",
    "youtube",
    "youtube-downloader",
    "youtube-downloader-cli",
    "youtube-mp4",
    "youtube-mp3",
    "mp4-downloader",
    "mp3-converter",
    "youtube-music",
    "instagram",
    "facebook",
    "tiktok",
    "pinterest",
    "twitter",
    "reddit",
    "threads",
    "twitch",
    "soundcloud",
    "downloader",
    "converter",
    "playlist",
    "batch",
    "resume",
    "retry",
    "archive",
    "metadata",
    "cookies",
    "sponsorblock",
    "subtitles",
    "config",
    "profiles",
    "history",
    "completion",
    "login",
    "supply-chain-security",
    "socket-security",
    "provenance",
    "sbom",
    "typescript",
    "typed-api",
    "termux",
    "ish",
    "ssh",
    "powershell",
    "cmd",
    "windows",
    "linux",
    "ubuntu",
    "debian",
    "fedora",
    "rhel",
    "opensuse",
    "arch",
    "manjaro",
    "alpine",
    "nixos",
    "flatpak",
    "snap",
    "appimage",
    "android",
    "apk",
    "exe",
    "macos",
    "automation",
    "json",
    "tui",
    "cli",
    "terminal",
    "commander",
    "figlet",
    "which",
    "isexe",
    "animated-progress",
    "browser-login",
    "trusted-publishing",
    "openid-connect",
    "oidc",
    "documentation-validation"
  ],
  "publisher": "Andhika Marcella Fernanda",
  "author": "Andhika Marcella Fernanda <andhikamarcella546@gmail.com>",
  "organization": {
    "name": "YTConv Project",
    "url": "https://github.com/andhikamarcella/YTConv"
  },
  "maintainers": [
    "Andhika Marcella Fernanda <andhikamarcella546@gmail.com>"
  ],
  "license": "ISC",
  "licenseUrl": "https://github.com/andhikamarcella/YTConv/blob/release/ytconv-1.7.0/cli/LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andhikamarcella/YTConv.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/andhikamarcella/YTConv/tree/release/ytconv-1.7.0/cli#readme",
  "bugs": {
    "url": "https://github.com/andhikamarcella/YTConv/issues"
  },
  "documentation": {
    "url": "https://github.com/andhikamarcella/YTConv/tree/release/ytconv-1.7.0/cli/docs",
    "installation": "https://github.com/andhikamarcella/YTConv/blob/release/ytconv-1.7.0/cli/docs/INSTALLATION.md",
    "commands": "https://github.com/andhikamarcella/YTConv/blob/release/ytconv-1.7.0/cli/docs/COMMANDS.md",
    "configuration": "https://github.com/andhikamarcella/YTConv/blob/release/ytconv-1.7.0/cli/docs/CONFIGURATION.md",
    "authentication": "https://github.com/andhikamarcella/YTConv/blob/release/ytconv-1.7.0/cli/docs/AUTHENTICATION.md",
    "troubleshooting": "https://github.com/andhikamarcella/YTConv/blob/release/ytconv-1.7.0/cli/docs/TROUBLESHOOTING.md",
    "packages": "https://github.com/andhikamarcella/YTConv/blob/release/ytconv-1.7.0/cli/docs/PACKAGES.md",
    "security": "https://github.com/andhikamarcella/YTConv/blob/release/ytconv-1.7.0/cli/SECURITY.md"
  },
  "releaseDate": "2026-08-05",
  "releaseNotes": "YTConv 1.7.0 completes the canonical repository migration to andhikamarcella/YTConv, adds comprehensive documentation and automated documentation validation, introduces npm Trusted Publishing through GitHub OIDC, and refreshes every supported package target.",
  "releaseNotesUrl": "https://github.com/andhikamarcella/YTConv/blob/release/ytconv-1.7.0/cli/CHANGELOG.md",
  "installer": {
    "type": "Multi-format release",
    "npm": "https://registry.npmjs.org/ytconv/-/ytconv-1.7.0.tgz",
    "release": "https://github.com/andhikamarcella/YTConv/releases/tag/ytconv-v1.7.0",
    "sha256Url": "https://github.com/andhikamarcella/YTConv/releases/download/ytconv-v1.7.0/SHA256SUMS.txt",
    "sbomUrl": "https://github.com/andhikamarcella/YTConv/releases/download/ytconv-v1.7.0/ytconv-1.7.0.cdx.json"
  },
  "securityCapabilities": {
    "network": "Only user-requested media/provider URLs, npm metadata checks, and allowlisted HTTPS engine release endpoints.",
    "childProcesses": "Executable plus argument arrays only; shell execution is disabled.",
    "filesystem": "User-selected output, YTConv configuration/cache, verified engine storage, and short-lived private cookie exports.",
    "environment": "Allowlisted configuration reads; secrets are stripped before child processes.",
    "telemetry": false
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.18.0",
  "preferGlobal": true,
  "sideEffects": false,
  "dependencies": {
    "commander": "14.0.3",
    "figlet": "1.11.4",
    "ink": "7.1.1",
    "isexe": "3.1.5",
    "react": "19.2.8",
    "which": "6.0.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "readmeFilename": "README.md"
}
