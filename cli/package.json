{
  "name": "ytconv",
  "version": "1.6.0",
  "description": "CLI-only media downloader with automatic setup and updates, official browser-session login, profiles, batch downloads, and multi-platform support.",
  "type": "module",
  "bin": {
    "ytconv": "bin/ytconv-auth.js"
  },
  "files": [
    "bin/*.js",
    "src/*.js",
    "scripts/*.js",
    "scripts/*.sh",
    "scripts/*.cmd",
    "scripts/*.ps1",
    "ish/VERSION",
    "ish/*.py",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node ./scripts/postinstall.js",
    "start": "node ./bin/ytconv-auth.js",
    "check": "node ./scripts/check-syntax.js",
    "check:ish": "python3 -m py_compile ./ish/ytconv.py ./ish/ytconv-core.py && sh -n ./scripts/install-ish.sh && sh -n ./scripts/install-termux.sh && sh -n ./scripts/install-unix.sh",
    "test": "node ./scripts/test-cli.js",
    "test:browser": "node ./scripts/test-managed-browser.js",
    "test:ish": "python3 ./ish/ytconv.py --version",
    "security": "npm audit --omit=dev && node --test ./test/security.test.js",
    "prepack": "npm run check && npm test && npm run check:ish"
  },
  "keywords": [
    "yt-dlp",
    "gallery-dl",
    "ffmpeg",
    "youtube",
    "youtube-music",
    "instagram",
    "facebook",
    "tiktok",
    "pinterest",
    "twitter",
    "reddit",
    "threads",
    "twitch",
    "soundcloud",
    "downloader",
    "converter",
    "playlist",
    "batch",
    "resume",
    "retry",
    "archive",
    "metadata",
    "cookies",
    "sponsorblock",
    "subtitles",
    "config",
    "profiles",
    "history",
    "completion",
    "login",
    "supply-chain-security",
    "termux",
    "ish",
    "ssh",
    "powershell",
    "cmd",
    "windows",
    "linux",
    "ubuntu",
    "debian",
    "fedora",
    "arch",
    "alpine",
    "macos",
    "automation",
    "json",
    "tui",
    "cli",
    "terminal"
  ],
  "publisher": "Andhika Marcella Fernanda",
  "author": "Andhika Marcella Fernanda <andhikamarcella546@gmail.com>",
  "organization": {
    "name": "YTConv Project",
    "url": "https://github.com/andhikamarcella/youtubetomp3"
  },
  "maintainers": [
    "Andhika Marcella Fernanda <andhikamarcella546@gmail.com>"
  ],
  "license": "MIT",
  "licenseUrl": "https://github.com/andhikamarcella/youtubetomp3/blob/release/ytconv-1.6.0-cli-only-final/cli/LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andhikamarcella/youtubetomp3.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/andhikamarcella/youtubetomp3/tree/release/ytconv-1.6.0-cli-only-final/cli#readme",
  "bugs": {
    "url": "https://github.com/andhikamarcella/youtubetomp3/issues"
  },
  "releaseDate": "2026-08-03",
  "releaseNotes": "YTConv 1.6.0 is the stable monochrome release with red-only errors, responsive terminal layouts, verified media-engine downloads, local token-free profiles, complete English documentation, and expanded dependency diagnostics.",
  "releaseNotesUrl": "https://github.com/andhikamarcella/youtubetomp3/blob/release/ytconv-1.6.0-cli-only-final/cli/CHANGELOG.md",
  "installer": {
    "type": "Tarball",
    "url": "https://registry.npmjs.org/ytconv/-/ytconv-1.6.0.tgz",
    "sha256Url": "https://github.com/andhikamarcella/youtubetomp3/releases/download/ytconv-v1.6.0/SHA256SUMS.txt",
    "metadataUrl": "https://github.com/andhikamarcella/youtubetomp3/releases/download/ytconv-v1.6.0/ytconv-1.6.0.metadata.json"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.0",
  "preferGlobal": true,
  "dependencies": {
