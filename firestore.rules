rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile: Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/sticker-history/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/sticker-favorites/{favId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Forum Messages: Authenticated users can read/write messages
    match /forum-messages/{messageId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.email == 'andhikamarcella546@gmail.com';
    }

    match /stickers/{stickerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
