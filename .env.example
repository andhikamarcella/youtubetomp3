# YTConv safe example environment. Copy to Railway variables; never commit real secrets.
NODE_ENV=production
APP_ENV=production
APP_NAME=YTConv
APP_VERSION=v4.0.0
PUBLIC_BASE_URL=https://your-domain.example
NEXTAUTH_URL=https://your-domain.example
WORKER_API_BASE=https://your-domain.example
PORT=3000
TRUST_PROXY=true
LOG_LEVEL=info
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MIN=0
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
NEXTAUTH_SECRET=replace-with-random-secret
SESSION_SECRET=replace-with-random-secret
COOKIE_SECRET=replace-with-random-secret
ENCRYPTION_KEY=replace-with-32-byte-key
JWT_SECRET=replace-with-random-secret
CSRF_SECRET=replace-with-random-secret
SECURE_COOKIES=true
COOKIE_SAME_SITE=lax
COOKIE_HTTP_ONLY=true
COOKIE_MAX_AGE_SECONDS=2592000
CORS_ORIGINS=https://your-domain.example
ALLOWED_HOSTS=your-domain.example
FORCE_HTTPS=true
ADMIN_USERNAME=admin
ADMIN_USER_HASH=sha256-of-admin-username
ADMIN_PASS_HASH=sha256-of-admin-password
ADMIN_BEARER=replace-with-random-admin-token
ADMIN_JWT_SECRET=replace-with-random-secret
ADMIN_SESSION_TTL_SECONDS=28800
ENABLE_CHEATS=false
LOAD_TEST_REPORT_TOKEN=replace-with-random-token
TURNSTILE_SITE_KEY=your-public-site-key
TURNSTILE_SECRET_KEY=your-private-secret-key
TURNSTILE_STRICT=true
TURNSTILE_REQUIRED_ROUTES=/api/convert,/api/contact,/admin/login,/api/assistant-chat
TURNSTILE_TIMEOUT_MS=7000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_API_KEY=your-youtube-api-key
GEMINI_API_KEY=your-gemini-api-key
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-service-account-json
FIREBASE_APP_CHECK_REQUIRED=false
CLOUDINARY_URL=cloudinary://key:secret@cloud
CLOUDINARY_AUDIO_URL=
CLOUDINARY_UPLOAD_FOLDER=ytconv/uploads
CLOUDINARY_AUDIO_FOLDER=ytconv/audio
CLOUDINARY_IMAGE_FOLDER=ytconv/images
CLOUDINARY_TEMP_FOLDER=ytconv/tmp
CLOUDINARY_SIGNED_UPLOADS=true
CLOUDINARY_WEBHOOK_SECRET=replace-with-random-secret
CLOUDINARY_MAX_IMAGE_MB=8
CLOUDINARY_MAX_AUDIO_MB=200
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
GROQ_API_KEY=your-groq-key
GROQ_API_KEY_FALLBACK=
GROQ_MODEL=llama-3.1-8b-instant
OAIBEST_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1024
WORKER_SHARED_SECRET=replace-with-random-secret
INTERNAL_API_KEY=replace-with-random-key
INTERNAL_REQUEST_TIMEOUT_MS=15000
YTDLP_JS_RUNTIME=node
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=
ENABLE_SERVER_COOKIES=true
COOKIES_PATH=/data/cookies.txt
COOKIE_STORE_PATH=/data/cookies-meta.json
COOKIES_TEST_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ
YTDLP_YOUTUBE_PLAYER_CLIENTS=mweb,web_safari,tv_embedded,android,default
YTDLP_YOUTUBE_PO_TOKEN=
YTDLP_AUTO_UPDATE=false
OUTPUT_DIR=/data/ytconv/outputs
TEMP_DIR=/tmp/ytconv-jobs
CACHE_DIR=/data/ytconv/cache
OUTPUT_TTL_MINUTES=60
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL_MS=600000
CONVERTER_CONCURRENCY=1
QUEUE_CONCURRENCY=1
MAX_PARALLEL_DOWNLOADS=1
MAX_QUEUE_SIZE=50
MAX_DURATION_SECONDS=7200
MAX_FILE_MB=800
MAX_PLAYLIST_ITEMS=25
ALLOW_PLAYLIST=true
DEFAULT_AUDIO_FORMAT=mp3
DEFAULT_AUDIO_QUALITY=320
ALLOWED_AUDIO_FORMATS=mp3,m4a,aac,opus,flac,wav,aiff,alac,caf,ogg
ALLOWED_VIDEO_FORMATS=mp4,webm,mkv
ALLOWED_AUDIO_QUALITIES=64,128,192,256,320
SIGNED_DOWNLOADS=true
DOWNLOAD_TOKEN_SECRET=replace-with-random-secret
DOWNLOAD_URL_TTL_SECONDS=1800
REDIS_URL=
QUEUE_DRIVER=memory
QUEUE_PREFIX=ytconv
QUEUE_REMOVE_ON_COMPLETE=true
QUEUE_REMOVE_ON_FAIL=false
QUEUE_JOB_TIMEOUT_MS=900000
FALLBACK_QUEUE_DRIVER=memory
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CONVERT_RATE_LIMIT_WINDOW_MS=60000
CONVERT_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
TICKET_RATE_LIMIT_WINDOW_MS=600000
TICKET_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=20
BLOCK_PRIVATE_IP_URLS=true
BLOCK_LOCALHOST_URLS=true
BLOCK_FILE_PROTOCOL=true
URL_FETCH_TIMEOUT_MS=10000
MAX_URL_LENGTH=2048
IP_BLOCKLIST=
IP_ALLOWLIST=
USER_AGENT_BLOCKLIST=
UPLOAD_MAX_MB=12
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif,video/mp4,audio/mpeg,audio/wav
UPLOAD_SCAN_ENABLED=false
MAINTENANCE_MODE=false
MAINTENANCE_PROGRESS=0
MAINTENANCE_ETA_MINUTES=0
MAINTENANCE_ID=
MAINTENANCE_DETAIL=Kami sedang melakukan peningkatan stabilitas layanan.
MAINTENANCE_TIP=Silakan coba lagi beberapa saat lagi.
MAINTENANCE_STEPS_JSON=[]
MAINTENANCE_WHATS_NEW_JSON=[]
MAINTENANCE_SERVICES_JSON={}
FEATURE_FORUM=true
FEATURE_TICKETS=true
FEATURE_AI_NAVIGATOR=true
FEATURE_CLOUDINARY_SAVE=true
FEATURE_SUBTITLE=true
FEATURE_PLAYLIST=true
FEATURE_PRIVATE_ROOM=true
FEATURE_PWA=true
FEATURE_VOICE=true
FEATURE_MINIGAME=true
MODERATION_ENABLED=true
CACHE_ENABLED=true
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=none
ANALYTICS_ENDPOINT=
METADATA_CACHE_TTL_SECONDS=21600
RESULT_CACHE_TTL_SECONDS=3600
MAX_LINKS_PER_MESSAGE=5
SPAM_DUPLICATE_WINDOW_MS=60000
SPAM_DUPLICATE_MAX=3
BANNED_DOMAINS=
BANNED_KEYWORDS=
RETENTION_FAILED_JOBS_DAYS=7
RETENTION_COMPLETED_JOBS_DAYS=1
RETENTION_TICKETS_DAYS=90
RETENTION_AUDIT_LOGS_DAYS=180
RETENTION_ANALYTICS_DAYS=90
RETENTION_CACHE_HOURS=24
RETENTION_CLOUDINARY_TEMP_HOURS=24
XP_MULTIPLIER_PREMIUM=1
SUPPORT_EMAIL=support@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SENTRY_DSN=
HEALTHCHECK_SECRET=replace-with-random-secret
ENABLE_REQUEST_LOGS=true
ENABLE_ERROR_STACKS=false
